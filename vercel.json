{
  "framework": "vite",
  "functions": {
    "api/analyze-fish.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/analysis.ts"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
