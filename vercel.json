{
  "framework": "vite",
  "functions": {
    "api/analyze-fish.ts": {
      "maxDuration": 120,
      "includeFiles": "{src/lib/analysis.ts,server/owner.ts}"
    },
    "api/owner.ts": { "includeFiles": "server/owner.ts" },
    "api/drawings.ts": { "includeFiles": "server/owner.ts" },
    "api/tanks.ts": { "includeFiles": "server/owner.ts" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
